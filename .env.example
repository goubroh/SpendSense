# Copy to .env and add keys only for the provider you intend to use.
# Never commit .env or share API keys. Leave keys empty for offline (rule-based) mode.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Provider: google, groq, openrouter, auto (first configured key), or offline
LLM_PROVIDER=google
# Use a model supported by the selected provider.
LLM_MODEL=gemini-2.5-flash

CURRENCY=₹
